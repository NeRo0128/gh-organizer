/* ═══════════════════════════════════════════════════════════════
 *  Identidad visual — clases reutilizables
 *  Cualquier pantalla las puede usar. No sobreescribir sin motivo.
 * ═══════════════════════════════════════════════════════════════ */

/* Barra superior de pantalla: 1 línea, fondo diferenciado */
.screen-topbar {
    height: 1;
    padding: 0 2;
    background: $boost;
    color: $foreground;
}

/* Panel: contenedor visual de la app (árbol, detalle, secciones…) */
.panel {
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 0 2;
}

.panel.-text-content {
    padding: 1 2;
}

.panel:focus,
.panel:focus-within {
    border: round $primary;
}

/* Item de sidebar / navegación */
.sidebar-item {
    padding: 1 2;
    height: 3;
    color: $foreground;
}

.sidebar-item.-active {
    background: $primary 35%;
    color: $foreground;
    text-style: bold;
}

/* Fila seleccionable (opciones, listas, etc.) */
.selectable-row {
    padding: 0 1;
    height: 1;
    color: $foreground;
}

.selectable-row.-selected {
    background: $primary 25%;
    text-style: bold;
}

/* Fila con ajuste pendiente de implementar */
.selectable-row.-pending {
    color: $warning 70%;
}

.selectable-row.-pending.-selected {
    background: $warning 20%;
    text-style: bold;
}

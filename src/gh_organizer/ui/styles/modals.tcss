/* src/gh_organizer/ui/styles/modals.tcss */

/* ────────────────────────────────────────────────────────── */
/*  Fondo oscuro global para TODOS los modales               */
/* ────────────────────────────────────────────────────────── */
ModalScreen {
    /* Usamos $background con un 80% de opacidad para un velo oscuro y consistente */
   background: rgba(0, 0, 0, 1.0) ;
}

/* ────────────────────────────────────────────────────────── */
/*  Estilos base para la caja de CUALQUIER modal             */
/* ────────────────────────────────────────────────────────── */
.modal-box {
    width: 90;
    height: auto;
    max-height: 90%;
    background: $surface; /* Fondo sólido para legibilidad */
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    text-align: center;
    width: 100%;
}

.modal-hint {
    margin-top: 1;
    color: $text-muted;
    text-align: center;
    width: 100%;
}

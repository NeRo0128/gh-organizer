/* src/github_organizer/ui/styles/main.tcss
 * MainScreen: topbar + árbol (1/3) + detalle/releases (2fr + 1fr) + commits.
 */

MainScreen {
    layout: vertical;
}

#topbar {
    height: 1;
    padding: 0 2;
    background: $boost;
    color: $foreground;
}

#main-layout {
    height: 1fr;
}

RepoTree {
    width: 1fr;
    border: round $primary;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 0 1;
}

RepoTree:focus {
    border: round $accent;
}

RepoTree > .tree--cursor {
    background: $primary 35%;
    color: $foreground;
    text-style: bold;
}

RepoTree > .tree--guides {
    color: $secondary;
}

#detail-panel {
    width: 2fr;
}

#detail-row {
    height: 2fr;
}

RepoDetail {
    width: 2fr;
    height: 1fr;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 2;
    background: $surface;
}

ReleasesPanel {
    width: 1fr;
    height: 1fr;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 2;
    background: $surface;
}

CommitsPanel {
    height: 1fr;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 2;
    background: $surface;
}

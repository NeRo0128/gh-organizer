/* src/github_organizer/ui/styles/main.tcss
 * MainScreen: topbar + árbol (45%) + detalle/releases (55%) + commits (1/3).
 */

MainScreen {
    layout: vertical;
}

#topbar {
    height: 1;
    padding: 0 2;
    background: $boost;
    color: $foreground;
}

#main-layout {
    height: 1fr;
}

/* ── Panel Izquierdo (Árbol) ────────────────────────────────────────── */

#tree-panel {
    width: 30%;
    height: 1fr;
}

#search-input {
    height: 3;
    margin: 0 0 1 0;
}

RepoTree {
    width: 1fr;
    height: 1fr;
    border: round $primary;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 0 1;
}

RepoTree:focus {
    border: round $accent;
}

RepoTree > .tree--cursor {
    background: $primary 35%;
    color: $foreground;
    text-style: bold;
}

RepoTree > .tree--guides {
    color: $secondary;
}

/* ── Panel Derecho (Detalles, Releases, Commits) ────────────────────── */

#detail-panel {
    width: 70%;
    height: 1fr;
}

/* La fila superior toma 2/3 del alto */
#detail-row {
    height: 2fr;
}

/* El panel de commits toma 1/3 del alto */
#commits-panel {
    height: 1fr;
}

/* ── Estilos de los Widgets del panel derecho ───────────────────────── */

RepoDetail {
    width: 2fr;
    height: 1fr;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 2;
    background: $surface;
}

ReleasesPanel {
    width: 1fr;
    height: 1fr;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 2;
    background: $surface;
}

CommitsPanel {
    width: 1fr;
    height: 1fr;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 2;
    background: $surface;
}
